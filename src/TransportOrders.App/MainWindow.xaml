<Window x:Class="TransportOrders.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TransportOrders.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Transport Orders — Extrusion Plant"
        Width="1180" Height="680" MinWidth="940" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.CommandBindings>
        <CommandBinding Command="Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Coloured pill showing an order status -->
        <DataTemplate x:Key="StatusBadge">
            <Border x:Name="Badge" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left"
                    Background="{StaticResource PlannedSoftBrush}">
                <TextBlock x:Name="Label" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PlannedBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InTransit">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource InTransitSoftBrush}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource InTransitBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource DoneSoftBrush}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DoneBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource CancelledSoftBrush}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource CancelledBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RightAligned" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="Counter" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ReloadCommand}" VerticalAlignment="Center"
                        ToolTip="Reload all orders from the database (F5)" AutomationProperties.Name="Reload">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" Margin="0,1,8,0" />
                        <TextBlock Text="Reload" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Transport Orders" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Internal material transport · aluminium extrusion plant"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar: counts cover every stored order, regardless of filter and search -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Margin="0,0,18,0"
                               Text="{Binding TotalCount, StringFormat='All orders: {0}'}" />
                    <StackPanel Style="{StaticResource Counter}">
                        <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource PlannedBrush}" />
                        <TextBlock Text="{Binding PlannedCount, StringFormat='Planned: {0}'}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Counter}">
                        <Ellipse Style="{StaticResource Dot}" Fill="#D08A12" />
                        <TextBlock Text="{Binding InTransitCount, StringFormat='InTransit: {0}'}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Counter}">
                        <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource DoneBrush}" />
                        <TextBlock Text="{Binding DoneCount, StringFormat='Done: {0}'}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Counter}">
                        <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource CancelledBrush}" />
                        <TextBlock Text="{Binding CancelledCount, StringFormat='Cancelled: {0}'}" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="(all stored orders, ignoring filter and search)" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Width="70" Height="4" Margin="0,0,8,0"
                                     Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                        <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource DoneBrush}" Margin="0,0,18,0" Text="{Binding LastAction}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastAction}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Shown: {0} of {1}">
                                <Binding Path="VisibleCount" />
                                <Binding Path="TotalCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="20,16,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar: status filter, search and actions -->
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="_Start" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Command="{Binding StartOrderCommand}"
                            ToolTip="Planned → InTransit (Alt+S)" />
                    <Button Content="_Complete" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Command="{Binding CompleteOrderCommand}"
                            ToolTip="InTransit → Done (Alt+C)" />
                    <Button Content="Ca_ncel" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                            Command="{Binding CancelOrderCommand}"
                            ToolTip="Planned or InTransit → Cancelled (Alt+N)" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ListBox Style="{StaticResource SegmentedList}"
                             ItemsSource="{Binding StatusFilters}"
                             SelectedItem="{Binding SelectedStatusFilter}"
                             AutomationProperties.Name="Status filter" />

                    <!-- Search box with icon, placeholder and clear button -->
                    <Border Margin="14,0,0,0" Width="250" Height="32" CornerRadius="6"
                            Background="{StaticResource SurfaceBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE721;"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="10,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Search order number (Ctrl+F)" IsHitTestVisible="False"
                                       Foreground="#98A2B0" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Case-insensitive search on the order number, e.g. 0007. Esc clears it."
                                     AutomationProperties.Name="Search order number">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Margin="0,0,4,0"
                                    Command="{Binding ClearSearchCommand}"
                                    ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search"
                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Contextual hint about what the selection allows -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,12,0,10">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="{Binding SelectionHint}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <!-- Orders card -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="1">
                <Grid>
                    <DataGrid ItemsSource="{Binding OrdersView}"
                              SelectedItem="{Binding SelectedOrder}"
                              IsSynchronizedWithCurrentItem="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              Background="Transparent"
                              RowBackground="{StaticResource SurfaceBrush}"
                              AlternatingRowBackground="#FAFBFC"
                              BorderThickness="0"
                              RowHeight="30"
                              AutomationProperties.Name="Transport orders">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F7FA" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter Property="Foreground" Value="{StaticResource CancelledBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F5FB" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <!-- Padded, vertically centred cells; selection stays visible without keyboard focus -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="10,0">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order No." Binding="{Binding OrderNumber}" Width="120" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*" />
                            <DataGridTextColumn Header="Quantity (pcs)" Binding="{Binding Quantity}" Width="110"
                                                ElementStyle="{StaticResource RightAligned}" />
                            <DataGridTextColumn Header="From" Binding="{Binding SourceLocation}" Width="*" />
                            <DataGridTextColumn Header="To" Binding="{Binding TargetLocation}" Width="*" />
                            <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="115"
                                                    CellTemplate="{StaticResource StatusBadge}" />
                            <DataGridTextColumn Header="Created (local)" Width="135"
                                                Binding="{Binding CreatedAtLocal, StringFormat='yyyy-MM-dd HH:mm'}" />
                            <DataGridTextColumn Header="Updated (local)" Width="135"
                                                Binding="{Binding UpdatedAtLocal, StringFormat='yyyy-MM-dd HH:mm'}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state when filter and search match nothing -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                                Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="28"
                                   Foreground="#B7C0CC" HorizontalAlignment="Center" />
                        <TextBlock Text="No orders match the current filter and search." FontSize="14"
                                   Margin="0,10,0,12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Button Content="Clear filters" HorizontalAlignment="Center"
                                Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
