<Window x:Class="TransportOrders.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TransportOrders.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Transport Orders — Extrusion Plant"
        Width="1100" Height="620" MinWidth="820" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="CountLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar: filter, search and actions -->
        <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Status" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" Width="130" VerticalContentAlignment="Center"
                      ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      AutomationProperties.Name="Status filter" />

            <TextBlock Grid.Column="2" Text="Order number" VerticalAlignment="Center" Margin="18,0,6,0" />
            <TextBox Grid.Column="3" MinWidth="180" MaxWidth="260" HorizontalAlignment="Left"
                     VerticalContentAlignment="Center" Padding="4,2"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Case-insensitive search on the order number, e.g. 0007"
                     AutomationProperties.Name="Search order number" />

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="Start" Command="{Binding StartOrderCommand}" ToolTip="Planned → InTransit" />
                <Button Content="Complete" Command="{Binding CompleteOrderCommand}" ToolTip="InTransit → Done" />
                <Button Content="Cancel" Command="{Binding CancelOrderCommand}" ToolTip="Planned or InTransit → Cancelled" />
            </StackPanel>
        </Grid>

        <!-- Status bar: counts cover every stored order, regardless of filter and search -->
        <StatusBar DockPanel.Dock="Bottom" Padding="8,2">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CountLabel}" FontWeight="SemiBold"
                               Text="{Binding TotalCount, StringFormat='All orders: {0}'}" />
                    <TextBlock Style="{StaticResource CountLabel}" Text="{Binding PlannedCount, StringFormat='Planned: {0}'}" />
                    <TextBlock Style="{StaticResource CountLabel}" Text="{Binding InTransitCount, StringFormat='InTransit: {0}'}" />
                    <TextBlock Style="{StaticResource CountLabel}" Text="{Binding DoneCount, StringFormat='Done: {0}'}" />
                    <TextBlock Style="{StaticResource CountLabel}" Text="{Binding CancelledCount, StringFormat='Cancelled: {0}'}" />
                    <TextBlock Foreground="Gray" Text="(counts ignore filter and search)" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="Gray" Margin="0,0,14,0" Text="{Binding LastAction}" />
                    <TextBlock Text="{Binding VisibleCount, StringFormat='Shown: {0}'}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <DataGrid ItemsSource="{Binding OrdersView}"
                  SelectedItem="{Binding SelectedOrder}"
                  IsSynchronizedWithCurrentItem="False"
                  Margin="12,0,12,8"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E3E3E3"
                  AlternatingRowBackground="#F7F9FB"
                  RowHeight="26"
                  AutomationProperties.Name="Transport orders">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                            <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order No." Binding="{Binding OrderNumber}" Width="110" />
                <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*" />
                <DataGridTextColumn Header="Quantity (pcs)" Binding="{Binding Quantity}" Width="105">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="From" Binding="{Binding SourceLocation}" Width="*" />
                <DataGridTextColumn Header="To" Binding="{Binding TargetLocation}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Created (local)" Width="130"
                                    Binding="{Binding CreatedAtLocal, StringFormat='yyyy-MM-dd HH:mm'}" />
                <DataGridTextColumn Header="Updated (local)" Width="130"
                                    Binding="{Binding UpdatedAtLocal, StringFormat='yyyy-MM-dd HH:mm'}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
