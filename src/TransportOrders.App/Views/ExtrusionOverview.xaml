<UserControl x:Class="TransportOrders.App.Views.ExtrusionOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:TransportOrders.App.Services">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{svc:Tr Plant_Title}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{svc:Tr Plant_Subtitle}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding ServiceStatus}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding RunLabel}" Command="{Binding ToggleRunCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{svc:Tr Plant_Step}" Command="{Binding StepCommand}" Margin="8,0" />
                    <Button Content="{Binding FaultLabel}" Command="{Binding ToggleFaultCommand}" />
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="5" Margin="0,16,0,14">
                <Border Style="{StaticResource Panel}" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Baskets}" /><TextBlock Text="{Binding BasketCount}" Style="{StaticResource Metric}" />
                </StackPanel></Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Moving}" /><TextBlock Text="{Binding MovingCount}" Style="{StaticResource Metric}" />
                </StackPanel></Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Held}" /><TextBlock Text="{Binding HeldCount}" Style="{StaticResource Metric}" />
                </StackPanel></Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Shipped}" /><TextBlock Text="{Binding ShippedCount}" Style="{StaticResource Metric}" />
                </StackPanel></Border>
                <Border Style="{StaticResource Panel}"><StackPanel>
                    <TextBlock Text="SHUTTLE-01" />
                    <TextBlock Text="{Binding EquipmentState}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource DoneBrush}" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True">
                        <ProgressBar.Style><Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MovingCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsFaulted}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style></ProgressBar.Style>
                    </ProgressBar>
                </StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Route}" FontWeight="SemiBold" FontSize="15" Margin="2,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Stations}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Margin="3" Padding="10" CornerRadius="6" BorderThickness="1" MinHeight="245">
                                <Border.Style><Style TargetType="Border">
                                    <Setter Property="Background" Value="#F5F8FC" />
                                    <Setter Property="BorderBrush" Value="#CCD9E9" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFull}" Value="True"><Setter Property="Background" Value="#FFF0D4" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HasReservation}" Value="True"><Setter Property="BorderBrush" Value="#1F5FA8" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Kind}" />
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,5" />
                                    <TextBlock Text="{Binding Capacity}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding Contents}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding EquipmentState}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Process}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,6,0,0">
                                        <ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers>
                                            <DataTrigger Binding="{Binding Process}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers></Style></ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{svc:Tr Plant_Legend}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="3,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#E3EEFA" CornerRadius="6" Padding="12,8" Margin="0,12">
                <StackPanel>
                    <TextBlock Text="{Binding LastEvent}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{svc:Tr Plant_DemoNote}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Equipment}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Equipment}" SelectedItem="{Binding SelectedEquipment}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Height="220" HeadersVisibility="Column" RowHeight="27"
                              AutomationProperties.Name="Plant equipment">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{svc:Tr Plant_EquipmentId}" Binding="{Binding Id}" Width="140" />
                            <DataGridTextColumn Header="{svc:Tr Plant_Kind}" Binding="{Binding Kind}" Width="150" />
                            <DataGridTextColumn Header="{svc:Tr Col_Status}" Binding="{Binding Status}" Width="150" />
                            <DataGridTextColumn Header="{svc:Tr Plant_Mode}" Binding="{Binding Mode}" Width="140" />
                            <DataGridTextColumn Header="{svc:Tr Plant_Operation}" Binding="{Binding Operation}" Width="*" MinWidth="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="{svc:Tr Plant_Mode}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" Width="130" />
                        <TextBlock Text="{svc:Tr Col_Status}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding SelectedCondition}" DisplayMemberPath="Label" Width="140" />
                        <TextBlock Text="{svc:Tr Plant_Reason}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Text="{Binding ControlReason, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                        <Button Content="{svc:Tr Plant_ApplyControl}" Command="{Binding ApplyControlCommand}" Margin="10,0,0,0" />
                        <Button Content="{svc:Tr ControlApi_Reload}" Command="{Binding ReloadControlsCommand}" Margin="8,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="5" Style="{StaticResource Panel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Baskets}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Baskets}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="230" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30" AutomationProperties.Name="Extrusion baskets">
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsMoving}" Value="True"><Setter Property="Background" Value="#FFF0D4" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsHeld}" Value="True"><Setter Property="Background" Value="#EDE9FE" /></DataTrigger>
                        </Style.Triggers></Style></DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{svc:Tr Details_Piece}" Binding="{Binding Number}" Width="145" />
                            <DataGridTextColumn Header="{svc:Tr Col_Heat}" Binding="{Binding Batch}" Width="100" />
                            <DataGridTextColumn Header="{svc:Tr Col_Material}" Binding="{Binding Material}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="{svc:Tr Plant_Position}" Binding="{Binding Position}" Width="210" />
                            <DataGridTextColumn Header="{svc:Tr Col_To}" Binding="{Binding Destination}" Width="90" />
                            <DataGridTextColumn Header="{svc:Tr Col_Status}" Binding="{Binding State}" Width="130" />
                            <DataGridTextColumn Header="{svc:Tr Col_OrderNo}" Binding="{Binding OrderNumber}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Row="6" Style="{StaticResource Panel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Events}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Basket}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3" Text="{Binding By}" Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
