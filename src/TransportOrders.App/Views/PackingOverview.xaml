<UserControl x:Class="TransportOrders.App.Views.PackingOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:TransportOrders.App.Services"
             Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock Text="{svc:Tr Plant_PackingTab}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{svc:Tr Plant_PackingGuide}" TextWrapping="Wrap" Margin="0,6,0,16" Foreground="{StaticResource MutedTextBrush}" />
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Packages}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Height="230" HeadersVisibility="Column" RowHeight="29"
                              AutomationProperties.Name="Packed packages">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{svc:Tr Plant_Package}" Binding="{Binding Number}" Width="155" />
                            <DataGridTextColumn Header="{svc:Tr Details_Piece}" Binding="{Binding Basket}" Width="150" />
                            <DataGridTextColumn Header="{svc:Tr Plant_Load}" Binding="{Binding Load}" Width="65" />
                            <DataGridTextColumn Header="{svc:Tr Plant_Lot}" Binding="{Binding Lot}" Width="150" />
                            <DataGridTextColumn Header="{svc:Tr Col_Quantity}" Binding="{Binding Quantity}" Width="75" />
                            <DataGridTextColumn Header="{svc:Tr Plant_Position}" Binding="{Binding Position}" Width="135" />
                            <DataGridTextColumn Header="{svc:Tr Col_Status}" Binding="{Binding Status}" Width="*" MinWidth="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanEditOrders}">
                        <CheckBox Content="{svc:Tr Plant_VisualCheck}" IsChecked="{Binding VisualPassed}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Content="{svc:Tr Plant_QuantityCheck}" IsChecked="{Binding QuantityVerified}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="{svc:Tr Plant_Reason}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding InspectionReason, UpdateSourceTrigger=PropertyChanged}" Width="260" />
                        <Button Content="{svc:Tr Plant_Inspect}" Command="{Binding InspectPackageCommand}" Margin="10,0,0,0" />
                    </WrapPanel>
                    <TextBlock Text="{svc:Tr Plant_Label}" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <TextBox Text="{Binding SelectedPackage.Label, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="165" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Plant_Reuse}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{svc:Tr Plant_ReuseGuide}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                    <WrapPanel IsEnabled="{Binding CanEditOrders}">
                        <TextBlock Text="{svc:Tr Details_Piece}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding EmptyBaskets}" SelectedItem="{Binding SelectedEmptyBasket}" DisplayMemberPath="Number" Width="155" />
                        <TextBlock Text="{svc:Tr Plant_Lot}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <ComboBox ItemsSource="{Binding PackingLots}" SelectedItem="{Binding ReloadLot}" DisplayMemberPath="Number" Width="155" />
                        <TextBlock Text="{svc:Tr Col_To}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <ComboBox ItemsSource="{Binding ReloadOvens}" SelectedItem="{Binding ReloadOven}" Width="100" />
                        <TextBlock Text="{svc:Tr Col_Quantity}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Text="{Binding ReloadQuantity, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                        <TextBlock Text="{svc:Tr Plant_Weight}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Text="{Binding ReloadWeight, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                        <TextBlock Text="{svc:Tr Plant_Length}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Text="{Binding ReloadLength, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                        <Button Content="{svc:Tr Plant_Reload}" Command="{Binding ReloadBasketCommand}" Margin="10,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
