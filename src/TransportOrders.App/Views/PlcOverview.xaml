<UserControl x:Class="TransportOrders.App.Views.PlcOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:TransportOrders.App.Services"
             Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{svc:Tr Plc_Tab}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{svc:Tr Plc_Guide}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,12,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{svc:Tr Plant_Step}" Command="{Binding StepCommand}" VerticalAlignment="Center"/>
            </Grid>
            <Border Background="#E3EEFA" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                <StackPanel><TextBlock Text="{Binding PlcChannelState}" FontWeight="SemiBold"/>
                    <TextBlock Text="{svc:Tr Plc_Policy}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Plc_Commands}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding PlcCommands}" SelectedItem="{Binding SelectedPlcCommand}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Height="310" HeadersVisibility="Column" MinRowHeight="36"
                              AutomationProperties.Name="PLC commands">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{svc:Tr Schedule_Reference}" Binding="{Binding Operation}" Width="170"/>
                            <DataGridTextColumn Header="{svc:Tr Plant_Kind}" Binding="{Binding Kind}" Width="150"/>
                            <DataGridTextColumn Header="{svc:Tr Col_Status}" Binding="{Binding Status}" Width="150"/>
                            <DataGridTextColumn Header="{svc:Tr Schedule_Route}" Binding="{Binding Route}" Width="185"/>
                            <DataGridTextColumn Header="{svc:Tr Plc_Attempts}" Binding="{Binding Attempts}" Width="80"/>
                            <DataGridTextColumn Header="{svc:Tr Plc_Deadline}" Binding="{Binding Deadline}" Width="100"/>
                            <DataGridTextColumn Header="{svc:Tr Plc_Detail}" Binding="{Binding Detail}" Width="*" MinWidth="300">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{svc:Tr Plc_Correlation}" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding SelectedPlcCommand.Id, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"/>
                    <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanEditOrders}">
                        <CheckBox Content="{svc:Tr Plc_ConnectedToggle}" IsChecked="{Binding PlcConnected}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <CheckBox Content="{svc:Tr Plc_SuppressToggle}" IsChecked="{Binding PlcSuppressReplies}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <TextBlock Text="{svc:Tr Plant_Reason}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding PlcReason, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                        <Button Content="{svc:Tr Plc_Apply}" Command="{Binding SetPlcSettingsCommand}" Margin="10,0,0,0"/>
                        <Button Content="{svc:Tr Plc_Retry}" Command="{Binding RetryPlcCommand}" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <Button Content="{svc:Tr Plc_ManualConfirm}" Command="{Binding ConfirmManualPlcCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
