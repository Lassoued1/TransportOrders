<UserControl x:Class="TransportOrders.App.Views.ScheduleOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:TransportOrders.App.Services"
             Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{svc:Tr Schedule_Tab}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{svc:Tr Schedule_Guide}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,12,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{svc:Tr Plant_Step}" Command="{Binding StepCommand}" VerticalAlignment="Center"/>
            </Grid>
            <Border Background="#E3EEFA" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Schedule_Next}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ScheduleNext}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Schedule_Candidates}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding ScheduledActions}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Height="280" HeadersVisibility="Column" MinRowHeight="36" AutomationProperties.Name="Production schedule">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40"/>
                            <DataGridTextColumn Header="{svc:Tr Schedule_Action}" Binding="{Binding Action}" Width="165"/>
                            <DataGridTextColumn Header="{svc:Tr Schedule_Reference}" Binding="{Binding Reference}" Width="145"/>
                            <DataGridTextColumn Header="{svc:Tr Plant_EquipmentId}" Binding="{Binding Equipment}" Width="105"/>
                            <DataGridTextColumn Header="{svc:Tr Schedule_Route}" Binding="{Binding Route}" Width="170"/>
                            <DataGridTextColumn Header="{svc:Tr Schedule_Recipe}" Binding="{Binding Recipe}" Width="105">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Baskets}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{svc:Tr Col_Priority}" Binding="{Binding Priority}" Width="70"/>
                            <DataGridTextColumn Header="{svc:Tr Schedule_Due}" Binding="{Binding Due}" Width="100"/>
                            <DataGridTextColumn Header="{svc:Tr Plant_Reason}" Binding="{Binding Reason}" Width="*" MinWidth="275">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{svc:Tr Schedule_Blocked}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding ScheduleBlocks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Height="260" HeadersVisibility="Column" MinRowHeight="36" AutomationProperties.Name="Schedule blocks">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{svc:Tr Schedule_Reference}" Binding="{Binding Reference}" Width="220"/>
                            <DataGridTextColumn Header="{svc:Tr Plant_EquipmentId}" Binding="{Binding Equipment}" Width="160"/>
                            <DataGridTextColumn Header="{svc:Tr Plant_Reason}" Binding="{Binding Reason}" Width="*" MinWidth="550">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
